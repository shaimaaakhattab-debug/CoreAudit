@model CoreAudit.Models.ServiceItem
@{
    ViewData["Title"] = Model.TitleAr;
    ViewData["MetaDescription"] = Model.DescriptionAr;
    ViewData["CtaHeading"] = Model.CtaHeadingAr;
    ViewData["CtaText"] = Model.CtaTextAr;
}

<section class="page-hero" aria-label="@Model.TitleAr">
    <div class="container">
        <h1 class="page-hero-title">@Model.TitleAr</h1>
        <p class="page-hero-sub">@(string.IsNullOrEmpty(Model.HeroSubAr) ? Model.DescriptionAr : Model.HeroSubAr)</p>
    </div>
</section>

<nav class="breadcrumb-bar" aria-label="مسار التنقل">
    <div class="container">
        <ol class="breadcrumb-list">
            <li><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
            <li><a asp-controller="Services" asp-action="Index">خدماتنا</a></li>
            <li aria-current="page">@Model.TitleAr</li>
        </ol>
    </div>
</nav>

<section class="section" aria-label="@Model.TitleAr">
    <div class="container">
        <div class="row g-4 g-lg-5 align-items-start">
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <div class="col-12 col-lg-5 order-first order-lg-last">
                <img src="@Model.ImagePath" alt="@Model.TitleAr" width="800" height="500" class="service-detail-img">
            </div>
        }
        <div class="col-12 col-lg-7">
        <div class="service-icon" aria-hidden="true">
            <i class="bi @Model.Icon"></i>
        </div>
        <p class="about-text">@Model.IntroAr</p>
        @foreach (var paragraph in Model.DetailParagraphsAr)
        {
            <p class="about-text">@paragraph</p>
        }
        @if (Model.DeliverablesAr.Count > 0 || Model.DetailParagraphsAr.Count > 0)
        {
            <h2 class="h4">الأنشطة الرئيسية</h2>
        }
        <p class="about-text"><strong>@Model.LeadInAr</strong></p>
        <ul class="about-points">
            @foreach (var bullet in Model.BulletsAr)
            {
                <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @bullet</li>
            }
        </ul>
        @if (Model.DeliverablesAr.Count > 0)
        {
            <h2 class="h4">المخرجات</h2>
            <ul class="about-points">
                @foreach (var item in Model.DeliverablesAr)
                {
                    <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @item</li>
                }
            </ul>
        }
        <a asp-controller="Services" asp-action="Index" class="btn btn-navy">العودة إلى خدماتنا</a>
        </div>
        </div>
    </div>
</section>

<partial name="_CtaSection" />
