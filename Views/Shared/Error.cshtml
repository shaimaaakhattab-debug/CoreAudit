@model ErrorViewModel
@{
    ViewData["Title"] = "حدث خطأ";
}

<section class="page-hero" aria-label="خطأ">
    <div class="container">
        <h1 class="page-hero-title">حدث خطأ غير متوقع</h1>
        <p class="page-hero-sub">نعتذر عن ذلك، يرجى المحاولة مرة أخرى.</p>
    </div>
</section>

<section class="section">
    <div class="container text-center">
        <p class="about-text mx-auto" style="max-width: 640px;">
            واجهنا مشكلة أثناء معالجة طلبك. يمكنك العودة إلى الصفحة الرئيسية أو التواصل معنا مباشرة.
        </p>
        @if (Model.ShowRequestId)
        {
            <p class="text-muted"><small>معرّف الطلب: <code dir="ltr">@Model.RequestId</code></small></p>
        }
        <a class="btn btn-navy mt-3" asp-controller="Home" asp-action="Index">العودة إلى الرئيسية</a>
    </div>
</section>
