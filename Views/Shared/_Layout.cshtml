@{
    var site = SiteOptions.Value;
    var metaDescription = ViewData["MetaDescription"] as string
        ?? "شركة كور أوديت (Core Audit) - محاسبون ومراجعون قانونيون. خدمات مهنية في المراجعة الخارجية والمحاسبة والاستشارات الضريبية والمالية.";
    var pageTitle = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(pageTitle != null ? $"{pageTitle} | " : "")@site.SiteTitleAr</title>
    <meta name="description" content="@metaDescription" />
    <meta name="theme-color" content="#1b2a4a" />
    <meta property="og:title" content="@site.SiteTitleAr" />
    <meta property="og:site_name" content="@site.SiteTitleAr" />
    <meta property="og:locale" content="ar_SA" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:type" content="website" />

    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <!-- Bootstrap 5.3.3 RTL (served locally to avoid CDN/SRI failures) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <!-- Bootstrap Icons 1.11.3 (served locally) -->
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <!-- Arabic + Latin fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="visually-hidden-focusable skip-link" href="#main-content">تخطَّ إلى المحتوى الرئيسي</a>

    <partial name="_Header" />

    <main id="main-content" role="main">
        @RenderBody()
    </main>

    <partial name="_Footer" />

    <a href="https://wa.me/966567334550?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D9%88%D8%AF%20%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D9%81%D8%B3%D8%A7%D8%B1%20%D8%B9%D9%86%20%D8%AE%D8%AF%D9%85%D8%A7%D8%AA%20%D8%B4%D8%B1%D9%83%D8%A9%20%D9%83%D9%88%D8%B1%20%D8%A3%D9%88%D8%AF%D9%8A%D8%AA%20%D9%84%D9%84%D9%85%D8%AD%D8%A7%D8%B3%D8%A8%D8%A9%20%D9%88%D8%A7%D9%84%D9%85%D8%B1%D8%A7%D8%AC%D8%B9%D8%A9."
       class="whatsapp-fab" target="_blank" rel="noopener noreferrer"
       aria-label="تواصل معنا عبر واتساب" title="تواصل معنا عبر واتساب">
        <i class="bi bi-whatsapp" aria-hidden="true"></i>
    </a>

    <button id="backToTop" class="back-to-top" type="button" aria-label="العودة إلى الأعلى" title="العودة إلى الأعلى">
        <i class="bi bi-arrow-up" aria-hidden="true"></i>
    </button>

    <!-- Bootstrap 5.3.3 bundle (Popper + JS) served locally; must load before site.js -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
