@using CoreAudit.Services
@inject IContentService ContentService
@{
    var site = SiteOptions.Value;
    var footerServices = ContentService.GetServices();
    var phoneTel = "tel:" + site.Phone;
}
<footer class="site-footer">
    <div class="container">
        <div class="row gy-4">
            <div class="col-lg-4">
                <img src="@site.LogoPath" alt="شعار @site.BrandNameAr - @site.BrandNameEn" class="footer-logo mb-3" />
                <h2 class="footer-brand h5">@site.BrandNameAr</h2>
                <p class="footer-sub">@site.BrandSubtitleAr</p>
                <p class="footer-desc">
                    مكتب مهني متخصص في المحاسبة والمراجعة، نلتزم بالدقة والشفافية والسرية في خدمة عملائنا.
                </p>
                @if (site.HasSocial)
                {
                    <ul class="social-links" aria-label="حسابات التواصل الاجتماعي">
                        @if (!string.IsNullOrWhiteSpace(site.YouTubeUrl))
                        {
                            <li><a href="@site.YouTubeUrl" target="_blank" rel="noopener noreferrer" aria-label="تابعنا على يوتيوب" title="يوتيوب"><i class="bi bi-youtube" aria-hidden="true"></i></a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(site.TwitterUrl))
                        {
                            <li><a href="@site.TwitterUrl" target="_blank" rel="noopener noreferrer" aria-label="تابعنا على منصة إكس" title="إكس (تويتر)"><i class="bi bi-twitter-x" aria-hidden="true"></i></a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(site.InstagramUrl))
                        {
                            <li><a href="@site.InstagramUrl" target="_blank" rel="noopener noreferrer" aria-label="تابعنا على إنستجرام" title="إنستجرام"><i class="bi bi-instagram" aria-hidden="true"></i></a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(site.TikTokUrl))
                        {
                            <li><a href="@site.TikTokUrl" target="_blank" rel="noopener noreferrer" aria-label="تابعنا على تيك توك" title="تيك توك"><i class="bi bi-tiktok" aria-hidden="true"></i></a></li>
                        }
                    </ul>
                }
            </div>

            <div class="col-6 col-lg-2">
                <h3 class="footer-heading h6">روابط سريعة</h3>
                <ul class="footer-links">
                    <li><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li><a asp-controller="About" asp-action="Index">من نحن</a></li>
                    <li><a asp-controller="Services" asp-action="Index">خدماتنا</a></li>
                    <li><a asp-controller="CrownPrince" asp-action="Index">ولي العهد</a></li>
                    <li><a asp-controller="Contact" asp-action="Index">تواصل معنا</a></li>
                </ul>
            </div>

            <div class="col-6 col-lg-3">
                <h3 class="footer-heading h6">خدماتنا</h3>
                <ul class="footer-links">
                    @foreach (var s in footerServices)
                    {
                        <li><a asp-controller="Services" asp-action="Index">@s.TitleAr</a></li>
                    }
                </ul>
            </div>

            <div class="col-lg-3">
                <h3 class="footer-heading h6">تواصل معنا</h3>
                <ul class="footer-contact">
                    <li>
                        <i class="bi bi-envelope-fill" aria-hidden="true"></i>
                        <a href="mailto:@site.Email" dir="ltr">@site.Email</a>
                    </li>
                    <li>
                        <i class="bi bi-telephone-fill" aria-hidden="true"></i>
                        <a href="@phoneTel" dir="ltr">@site.Phone</a>
                    </li>
                    @if (site.HasWhatsApp)
                    {
                        <li>
                            <i class="bi bi-whatsapp" aria-hidden="true"></i>
                            <a href="https://wa.me/@site.WhatsAppInternational.TrimStart('+')" target="_blank" rel="noopener">واتساب</a>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <hr class="footer-divider" />
        <div class="footer-bottom">
            <span>&copy; @DateTime.Now.Year @site.BrandNameAr (@site.BrandNameEn). جميع الحقوق محفوظة.</span>
        </div>
    </div>
</footer>
